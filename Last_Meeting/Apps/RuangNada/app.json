{
  "id": "ruangnada",
  "name": "RuangNada",
  "description": "Studio lokal untuk mengolah audio, video, dan gambar.",
  "category": "Multimedia",
  "entry": "webapp.py",
  "runtime": "python",
  "launch": "module",
  "module": "uvicorn",
  "args": [
    "webapp:app",
    "--host",
    "127.0.0.1",
    "--port",
    "8765"
  ],
  "working_directory": ".",
  "interpreter": ".venv/Scripts/python.exe",
  "env": {
    "MUSIC_WEB_DATA_DIR": ".data"
  },
  "url": "http://127.0.0.1:8765",
  "health_path": "/api/health",
  "port": 8765,
  "icon": "",
  "favorite": true,
  "dependencies": [
    "fastapi",
    "uvicorn",
    "yt_dlp",
    "PIL",
    "imageio_ffmpeg"
  ]
}
